{
  "$defs": {
    "Blocker": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pin"
            },
            "part": {
              "$ref": "#/$defs/PartRef"
            },
            "pin": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "part",
            "pin"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wire_end"
            },
            "wire": {
              "$ref": "#/$defs/WireRef"
            }
          },
          "required": [
            "kind",
            "wire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wire_body"
            },
            "wire": {
              "$ref": "#/$defs/WireRef"
            }
          },
          "required": [
            "kind",
            "wire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "overlap"
            },
            "wire": {
              "$ref": "#/$defs/WireRef"
            }
          },
          "required": [
            "kind",
            "wire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sheet"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Bounds": {
      "additionalProperties": false,
      "description": "An axis-aligned rectangle; min <= max on both axes, inside the sheet limits.",
      "properties": {
        "max": {
          "$ref": "#/$defs/Point"
        },
        "min": {
          "$ref": "#/$defs/Point"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "Catalog": {
      "additionalProperties": false,
      "properties": {
        "edit_operations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "name": {
                "enum": [
                  "place_part",
                  "add_wires",
                  "add_label",
                  "move",
                  "reorient",
                  "delete",
                  "set_text"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "command",
              "description"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "error_codes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "#/$defs/ErrorCode"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "retryable"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "default_page_size": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "file_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "idempotency_cache_entries": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "max_page_size": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "open_documents": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "operations_per_request": {
              "minimum": 0,
              "type": "integer"
            },
            "request_bytes": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "request_bytes",
            "file_bytes",
            "operations_per_request",
            "default_page_size",
            "max_page_size",
            "idempotency_cache_entries",
            "open_documents"
          ],
          "type": "object"
        },
        "operations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "destructive": {
                "type": "boolean"
              },
              "idempotency_key": {
                "type": "boolean"
              },
              "idempotent": {
                "type": "boolean"
              },
              "name": {
                "$ref": "#/$defs/OpName"
              },
              "params_schema": {
                "type": "string"
              },
              "read_only": {
                "type": "boolean"
              },
              "response_schema": {
                "type": "string"
              },
              "tiers": {
                "items": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "tool",
              "tiers",
              "read_only",
              "destructive",
              "idempotent",
              "idempotency_key",
              "params_schema",
              "response_schema",
              "description"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "orientations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol_revisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "units": {
          "additionalProperties": false,
          "properties": {
            "grid_nm": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "pin_lattice_nm": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "sheet_limit_nm": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "grid_nm",
            "pin_lattice_nm",
            "sheet_limit_nm"
          ],
          "type": "object"
        }
      },
      "required": [
        "protocol_revisions",
        "units",
        "limits",
        "operations",
        "edit_operations",
        "orientations",
        "text_fields",
        "error_codes"
      ],
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "items": {
            "$ref": "#/$defs/ItemRef"
          },
          "type": "array"
        },
        "dirty": {
          "$ref": "#/$defs/Bounds"
        },
        "nets_changed": {
          "type": "boolean"
        },
        "removed": {
          "items": {
            "$ref": "#/$defs/ItemRef"
          },
          "type": "array"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "added",
        "removed",
        "nets_changed"
      ],
      "type": "object"
    },
    "ChangeResult": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/Change"
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    },
    "CloseResult": {
      "additionalProperties": false,
      "properties": {
        "discarded": {
          "type": "boolean"
        }
      },
      "required": [
        "discarded"
      ],
      "type": "object"
    },
    "Diff": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "modified": {
          "items": {
            "$ref": "#/$defs/Modified"
          },
          "type": "array"
        },
        "removed": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "added",
        "removed",
        "modified",
        "truncated"
      ],
      "type": "object"
    },
    "DocId": {
      "description": "A document id, never reused within a session.",
      "pattern": "^d(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "DocInfo": {
      "additionalProperties": false,
      "properties": {
        "dirty": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "dirty"
      ],
      "type": "object"
    },
    "EditResult": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/Change"
        },
        "diff": {
          "$ref": "#/$defs/Diff"
        }
      },
      "required": [
        "change",
        "diff"
      ],
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "description": "A structured error (AD6, section 9.4).",
      "oneOf": [
        {
          "properties": {
            "code": {
              "const": "invalid_request"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "schema_violation"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unknown_operation"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "limit_exceeded"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "enum": [
                    "request_bytes",
                    "file_bytes",
                    "operations",
                    "page_size",
                    "open_documents"
                  ],
                  "type": "string"
                },
                "value": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "limit",
                "value"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unsupported_in_mode"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "protocol_version_unsupported"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "document_not_found"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unknown_symbol"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unknown_item"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "out_of_bounds"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "invalid_wire"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "missing_item"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "item": {
                  "$ref": "#/$defs/ItemRef"
                }
              },
              "required": [
                "item"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "duplicate_item"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "item": {
                  "$ref": "#/$defs/ItemRef"
                }
              },
              "required": [
                "item"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "invalid_text_field"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "enum": [
                    "designator",
                    "value",
                    "label"
                  ],
                  "type": "string"
                },
                "item": {
                  "$ref": "#/$defs/ItemRef"
                }
              },
              "required": [
                "item",
                "field"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "follow_no_route"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "blocker": {
                  "$ref": "#/$defs/Blocker"
                },
                "from": {
                  "$ref": "#/$defs/Point"
                },
                "to": {
                  "$ref": "#/$defs/Point"
                }
              },
              "required": [
                "from",
                "to",
                "blocker"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "segment_blocked"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "blocker": {
                  "$ref": "#/$defs/Blocker"
                }
              },
              "required": [
                "blocker"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "wire_capture"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "blocker": {
                  "$ref": "#/$defs/Blocker"
                },
                "wire": {
                  "$ref": "#/$defs/WireRef"
                }
              },
              "required": [
                "wire",
                "blocker"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "off_lattice"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "at": {
                  "$ref": "#/$defs/Point"
                }
              },
              "required": [
                "at"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "stale_revision"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "actual": {
                  "minimum": 0,
                  "type": "integer"
                },
                "expected": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "expected",
                "actual"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "preview_mismatch"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "idempotency_conflict"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "user_gesture_in_progress"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "nothing_to_undo"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "nothing_to_redo"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "approval_required"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "approval_id": {
                  "type": "string"
                },
                "effect": {
                  "enum": [
                    "edit",
                    "write_file",
                    "overwrite_file",
                    "discard_unsaved"
                  ],
                  "type": "string"
                },
                "effect_digest": {
                  "type": "string"
                },
                "tier": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "approval_id",
                "tier",
                "effect",
                "effect_digest"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "approval_denied"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "path_outside_root"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "file_exists"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "io_error"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unsupported_file_version"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "cancelled"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "job_not_found"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "internal"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        }
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "type": "object"
        },
        "hint": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "schema_violation",
        "unknown_operation",
        "limit_exceeded",
        "unsupported_in_mode",
        "protocol_version_unsupported",
        "document_not_found",
        "unknown_symbol",
        "unknown_item",
        "out_of_bounds",
        "invalid_wire",
        "missing_item",
        "duplicate_item",
        "invalid_text_field",
        "follow_no_route",
        "segment_blocked",
        "wire_capture",
        "off_lattice",
        "stale_revision",
        "preview_mismatch",
        "idempotency_conflict",
        "user_gesture_in_progress",
        "nothing_to_undo",
        "nothing_to_redo",
        "approval_required",
        "approval_denied",
        "path_outside_root",
        "file_exists",
        "io_error",
        "unsupported_file_version",
        "cancelled",
        "job_not_found",
        "internal"
      ],
      "type": "string"
    },
    "InspectResult": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "$ref": "#/$defs/ItemsPage"
        },
        "nets": {
          "items": {
            "$ref": "#/$defs/Net"
          },
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        }
      },
      "type": "object"
    },
    "Item": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/PartRef"
            },
            "part": {
              "$ref": "#/$defs/PartBody"
            }
          },
          "required": [
            "id",
            "part"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/WireRef"
            },
            "wire": {
              "$ref": "#/$defs/WireBody"
            }
          },
          "required": [
            "id",
            "wire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/LabelRef"
            },
            "label": {
              "$ref": "#/$defs/LabelBody"
            }
          },
          "required": [
            "id",
            "label"
          ],
          "type": "object"
        }
      ]
    },
    "ItemRef": {
      "description": "An item id, 0-based (AQ5).",
      "pattern": "^(part|wire|label):(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "ItemsPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "JobId": {
      "description": "A job id.",
      "pattern": "^j(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "JobState": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/Error"
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled_by_client",
