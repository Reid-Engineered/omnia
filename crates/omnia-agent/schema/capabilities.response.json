            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "job_not_found"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "internal"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        }
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "type": "object"
        },
        "hint": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "schema_violation",
        "unknown_operation",
        "limit_exceeded",
        "unsupported_in_mode",
        "protocol_version_unsupported",
        "document_not_found",
        "unknown_symbol",
        "unknown_item",
        "out_of_bounds",
        "invalid_wire",
        "missing_item",
        "duplicate_item",
        "invalid_text_field",
        "follow_no_route",
        "segment_blocked",
        "wire_capture",
        "off_lattice",
        "stale_revision",
        "preview_mismatch",
        "idempotency_conflict",
        "user_gesture_in_progress",
        "nothing_to_undo",
        "nothing_to_redo",
        "approval_required",
        "approval_denied",
        "path_outside_root",
        "file_exists",
        "io_error",
        "unsupported_file_version",
        "cancelled",
        "job_not_found",
        "internal"
      ],
      "type": "string"
    },
    "ItemRef": {
      "description": "An item id, 0-based (AQ5).",
      "pattern": "^(part|wire|label):(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "OpName": {
      "enum": [
        "capabilities",
        "new",
        "open",
        "close",
        "inspect",
        "query",
        "nets",
        "validate",
        "preview",
        "apply",
        "undo",
        "redo",
        "save",
        "request_status",
        "job_status",
        "job_cancel"
      ],
      "type": "string"
    },
    "PartRef": {
      "description": "A part id, 0-based (AQ5).",
      "pattern": "^part:(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Point": {
      "description": "[x, y] in integer nanometres (AK8).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "Warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "WireRef": {
      "description": "A wire id, 0-based (AQ5).",
      "pattern": "^wire:(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "result"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "doc_id": {
      "$ref": "#/$defs/DocId"
    },
    "error": {
      "$ref": "#/$defs/Error"
    },
    "result": {
      "$ref": "#/$defs/Catalog"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "const": "omnia.agent/1"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "warnings"
  ],
  "title": "capabilities.response",
  "type": "object"
}
