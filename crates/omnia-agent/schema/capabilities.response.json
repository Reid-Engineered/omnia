            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "document_not_found"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unknown_symbol"
