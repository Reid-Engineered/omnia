            "details": {
              "additionalProperties": false,
              "properties": {
                "actual": {
                  "minimum": 0,
                  "type": "integer"
                },
                "expected": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "expected",
                "actual"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "preview_mismatch"
