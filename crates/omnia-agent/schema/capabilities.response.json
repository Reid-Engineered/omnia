{
  "$defs": {
    "Blocker": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pin"
            },
            "part": {
              "$ref": "#/$defs/PartRef"
            },
            "pin": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "part",
            "pin"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wire_end"
            },
            "wire": {
              "$ref": "#/$defs/WireRef"
            }
          },
          "required": [
            "kind",
            "wire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wire_body"
            },
            "wire": {
              "$ref": "#/$defs/WireRef"
            }
          },
          "required": [
            "kind",
            "wire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "overlap"
            },
            "wire": {
              "$ref": "#/$defs/WireRef"
            }
          },
          "required": [
            "kind",
            "wire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sheet"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Catalog": {
      "additionalProperties": false,
      "properties": {
        "edit_operations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "name": {
                "enum": [
                  "place_part",
                  "add_wires",
                  "add_label",
                  "move",
                  "reorient",
                  "delete",
                  "set_text"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "command",
              "description"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "error_codes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "#/$defs/ErrorCode"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "retryable"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "default_page_size": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "file_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "idempotency_cache_entries": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "max_page_size": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "open_documents": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "operations_per_request": {
              "minimum": 0,
              "type": "integer"
            },
            "request_bytes": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "request_bytes",
            "file_bytes",
            "operations_per_request",
            "default_page_size",
            "max_page_size",
            "idempotency_cache_entries",
            "open_documents"
          ],
          "type": "object"
        },
        "operations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "destructive": {
                "type": "boolean"
              },
              "idempotency_key": {
                "type": "boolean"
              },
              "idempotent": {
                "type": "boolean"
              },
              "name": {
                "$ref": "#/$defs/OpName"
              },
              "params_schema": {
                "type": "string"
              },
              "read_only": {
                "type": "boolean"
              },
              "response_schema": {
                "type": "string"
              },
              "tiers": {
                "items": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "tool",
              "tiers",
              "read_only",
              "destructive",
              "idempotent",
              "idempotency_key",
              "params_schema",
              "response_schema",
              "description"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "orientations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol_revisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "units": {
          "additionalProperties": false,
          "properties": {
            "grid_nm": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "pin_lattice_nm": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "sheet_limit_nm": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "grid_nm",
            "pin_lattice_nm",
            "sheet_limit_nm"
          ],
          "type": "object"
        }
      },
      "required": [
        "protocol_revisions",
        "units",
        "limits",
        "operations",
        "edit_operations",
        "orientations",
        "text_fields",
        "error_codes"
      ],
      "type": "object"
    },
    "DocId": {
      "description": "A document id, never reused within a session.",
      "pattern": "^d(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Error": {
      "additionalProperties": false,
      "description": "A structured error (AD6, section 9.4).",
      "oneOf": [
        {
          "properties": {
            "code": {
              "const": "invalid_request"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "schema_violation"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unknown_operation"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "limit_exceeded"
