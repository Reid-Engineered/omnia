            "details": {
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "enum": [
                    "request_bytes",
                    "file_bytes",
                    "operations",
                    "page_size",
                    "open_documents"
                  ],
                  "type": "string"
                },
                "value": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "limit",
                "value"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "unsupported_in_mode"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
