                  "$ref": "#/$defs/WireRef"
                }
              },
              "required": [
                "wire",
                "blocker"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "off_lattice"
            },
            "details": {
              "additionalProperties": false,
