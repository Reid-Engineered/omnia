            "details": {
              "additionalProperties": false,
              "properties": {
                "approval_id": {
                  "type": "string"
                },
                "effect": {
                  "enum": [
                    "edit",
                    "write_file",
                    "overwrite_file",
                    "discard_unsaved"
                  ],
                  "type": "string"
                },
                "effect_digest": {
                  "type": "string"
                },
                "tier": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "approval_id",
                "tier",
                "effect",
                "effect_digest"
              ],
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "approval_denied"
