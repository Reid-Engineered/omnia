        {
          "properties": {
            "code": {
              "const": "nothing_to_redo"
            },
            "details": {
              "additionalProperties": false,
              "properties": {},
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "approval_required"
