{
  "$defs": {
    "DocId": {
      "description": "A document id, never reused within a session.",
      "pattern": "^d(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Point": {
      "description": "[x, y] in integer nanometres (AK8).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "WireRef": {
      "description": "A wire id, 0-based (AQ5).",
      "pattern": "^wire:(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "not": {
    "required": [
      "at",
      "wire"
    ]
  },
  "properties": {
    "at": {
      "$ref": "#/$defs/Point"
    },
    "doc_id": {
      "$ref": "#/$defs/DocId"
    },
    "wire": {
      "$ref": "#/$defs/WireRef"
    }
  },
  "required": [
    "doc_id"
  ],
  "title": "nets.params",
  "type": "object"
}
