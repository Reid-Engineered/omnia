{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "description": "An axis-aligned rectangle inside the sheet limits. The decoder also requires min <= max on both axes (mcp-plan.md section 9.1).",
      "properties": {
        "max": {
          "$ref": "#/$defs/SheetPoint"
        },
        "min": {
          "$ref": "#/$defs/SheetPoint"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "DocId": {
      "description": "A document id, never reused within a session.",
      "pattern": "^d(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "SheetPoint": {
      "description": "[x, y] in integer nanometres inside the K1 sheet limits.",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "type": "integer"
        },
        {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "type": "integer"
        }
      ],
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "area": {
      "$ref": "#/$defs/Bounds"
    },
    "cursor": {
      "type": "string"
    },
    "doc_id": {
      "$ref": "#/$defs/DocId"
    },
    "include": {
      "items": {
        "enum": [
          "summary",
          "items",
          "nets"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "limit": {
      "maximum": 5000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "doc_id",
    "include"
  ],
  "title": "inspect.params",
  "type": "object"
}
